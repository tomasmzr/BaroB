# Copiá este archivo a .env.local y completá con los datos de tu proyecto Supabase
# (Project Settings → API). La anon key es pública por diseño: la seguridad la da RLS.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Clave pública VAPID para notificaciones push (ver README: "Notificaciones").
VITE_VAPID_PUBLIC_KEY=
